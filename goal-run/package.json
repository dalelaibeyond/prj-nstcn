{
  "name": "nexstack-ai-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/check.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "preview": "npm run start",
    "check": "node scripts/check.mjs",
    "check:types": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "gate": "node scripts/gate.mjs",
    "build:production": "SITE_ENV=production astro build && node scripts/check.mjs && node scripts/gate.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.5",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/nodemailer": "^8.0.2",
    "cheerio": "^1.1.0",
    "postcss": "^8.5.0",
    "smtp-server": "^3.16.0",
    "typescript": "^6.0.3"
  }
}
