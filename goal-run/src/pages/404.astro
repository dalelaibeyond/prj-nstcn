---
import { loadContent } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import CopyBlocks from '../components/CopyBlocks.astro';
export const prerender = true;
const c = await loadContent();
const copy = c.pages.find(p => p.path === '/404/')!;
---
<Layout content={c} title={copy.seoTitle} description={copy.seoDescription}><PageIntro content={c} title={copy.title} eyebrow="NEXSTACK AI" description={copy.description} /><section class="section container"><CopyBlocks blocks={copy.blocks} /></section></Layout>
