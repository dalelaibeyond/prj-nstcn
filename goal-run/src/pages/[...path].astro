---
import { loadContent } from '../lib/content';
import { routes } from '../lib/routes';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PageBody from '../components/PageBody.astro';
export const prerender = true;
export async function getStaticPaths() {
  const c = await loadContent();
  return routes(c).map(route => ({ params: { path: route.path }, props: { kind: route.kind, id: route.id } }));
}
const { kind, id } = Astro.props;
const c = await loadContent();
const copy = c.pages.find(p => p.path === Astro.url.pathname);
if (!copy) throw new Error(`Missing page copy: ${Astro.url.pathname}`);
---
<Layout content={c} title={copy.seoTitle} description={copy.seoDescription} faq={kind === 'faq'}><PageIntro content={c} title={copy.title} eyebrow="NEXSTACK AI" description={copy.description} sample={kind === 'case'} /><PageBody content={c} kind={kind} id={id} /></Layout>
