---
import Concept from './Concept.astro';
import DirectionCards from './DirectionCards.astro';
import CopyBlocks from './CopyBlocks.astro';
import type { Content } from '../lib/content';
interface Props { content: Content }
const { content: c } = Astro.props;
const copy = c.pages.find(p => p.path === '/')!;
const remaining = copy.blocks.slice(copy.blocks.findIndex(b => b.text === 'Custom development around a clear brief'));
---
<section class="container hero"><div class="hero__copy"><p class="eyebrow">NEXSTACK AI</p><h1>{copy.title}</h1><p class="description">{copy.description}</p><div class="actions"><a href="/contact/" class="button">Discuss your project<span aria-hidden="true">↗</span></a><a href="/products/" class="button button--secondary">Explore our products</a></div></div><figure class="hero__art"><Concept label={c.t('illustrationLabel')} /><figcaption>{c.t('illustration')}</figcaption></figure></section>
<section class="section section--surface"><div class="container"><h2>Choose your starting point</h2><DirectionCards content={c} blocks={copy.blocks} /></div></section><section class="section"><div class="container"><article class="article"><CopyBlocks blocks={remaining} /></article></div></section>
