---
import Concept from './Concept.astro';
import ProductCards from './ProductCards.astro';
import CaseCards from './CaseCards.astro';
import InsightCards from './InsightCards.astro';
import Capabilities from './Capabilities.astro';
import Asset from './Asset.astro';
import type { Content } from '../lib/content';
interface Props { content: Content }
const { content: c } = Astro.props;
const { t, site } = c;
---
<section class="container hero"><div class="hero__copy"><p class="eyebrow">{t('heroEyebrow')}</p><h1>{t('heroTitle')}</h1><p class="description">{t('heroDescription')}</p><div class="actions"><a href="/products/" class="button">{t('heroPrimary')}<span aria-hidden="true">↗</span></a><a href="/contact/" class="button button--secondary">{t('heroSecondary')}</a></div></div><figure class="hero__art"><Concept label={t('illustrationLabel')} /><figcaption>{t('illustration')}</figcaption></figure></section>
<div class="container">{site.demo ? <Asset content={c} asset={site.demo} /> : <div class="demo-strip"><div class="demo-strip__content"><span class="demo-strip__icon" aria-hidden="true">▷</span><div><p class="demo-strip__title">{t('heroDemo')}</p><p class="small-note">{t('heroDemoNote')}</p></div></div><p class="small-note">{t('location')}</p></div>}<div class="metrics">{site.metrics.map(metric => <div class="metric" data-example={String(metric.isExample)}><p class="metric__value">{metric.value}</p><p class="metric__label">{metric.label}</p></div>)}</div>{site.metrics.some(m => m.isExample) && <p class="small-note metrics-note">{t('metricsNote')}</p>}</div>
<section class="section section--surface"><div class="container"><div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">{t('productsEyebrow')}</p><h2>{t('productsTitle')}</h2><p>{t('productsDescription')}</p></div><a class="text-link" href="/compare/">{t('compare')}<span aria-hidden="true">↗</span></a></div><ProductCards content={c} /></div></section>
<section class="section"><div class="container"><div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">{t('customEyebrow')}</p><h2>{t('customTitle')}</h2><p>{t('customDescription')}</p></div><a class="text-link" href="/custom/">{t('capabilitiesTitle')}<span aria-hidden="true">↗</span></a></div><Capabilities content={c} /></div></section>
<section class="section section--surface"><div class="container"><div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">{t('casesEyebrow')}</p><h2>{t('casesTitle')}</h2><p>{t('casesDescription')}</p></div><a class="text-link" href="/case-studies/">{t('casesAll')}<span aria-hidden="true">↗</span></a></div><CaseCards content={c} /></div></section>
<section class="section"><div class="container"><div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">{t('insightsEyebrow')}</p><h2>{t('insightsTitle')}</h2></div><a class="text-link" href="/insights/">{t('insightsAll')}<span aria-hidden="true">↗</span></a></div><InsightCards content={c} /></div></section>
