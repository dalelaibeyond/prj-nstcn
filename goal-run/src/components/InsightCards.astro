---
import type { Content } from '../lib/content';
interface Props { content: Content }
const { content: c } = Astro.props;
---
<div class="card-grid">{c.insights.map((item, i) => <article class="resource-card"><div class="resource-card__symbol" aria-hidden="true">{['↗', '⊕', '≡'][i]}</div><p class="eyebrow">{item.category}</p><h3><a href={item.path}>{item.title}</a></h3><p>{item.description}</p><a class="text-link" href={item.path}>{c.t('insightLink')}<span aria-hidden="true">↗</span></a></article>)}</div>
