---
import type { Content } from '../lib/content';
import Concept from './Concept.astro';
interface Props { content: Content; blocks: Content['pages'][number]['blocks'] }
const { content: c, blocks } = Astro.props;
const cards = c.products.map(product => {
  const index = blocks.findIndex(b => b.type === 'heading' && b.text?.toLowerCase() === product.name.toLowerCase());
  return { product, description: blocks[index + 1]?.text, link: blocks[index + 2] };
});
---
<div class="card-grid">{cards.map(({ product, description, link }, i) => <article class="product-card"><figure class="product-card__art"><Concept kind={product.id} label={`Concept illustration for ${product.name}`} /><figcaption class="small-note">{c.t('illustration')}</figcaption></figure><div class="product-card__body"><p class="product-card__number" aria-hidden="true">{String(i + 1).padStart(2, '0')} /</p><h3><a href={product.path}>{product.name}</a></h3><p>{description}</p><a class="text-link" href={product.path}>{link?.text ?? c.t('productLink')}<span aria-hidden="true">↗</span></a></div></article>)}</div>
