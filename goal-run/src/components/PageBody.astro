---
import type { Content } from '../lib/content';
import ProductCards from './ProductCards.astro';
import CaseCards from './CaseCards.astro';
import InsightCards from './InsightCards.astro';
import Capabilities from './Capabilities.astro';
import Concept from './Concept.astro';
import CertificationList from './CertificationList.astro';
import ContactForm from './ContactForm.astro';
import Compare from './Compare.astro';
import Asset from './Asset.astro';
interface Props { content: Content; kind: string; id?: string }
const { content: c, kind, id } = Astro.props;
const { site, t } = c;
const product = c.products.find(item => item.id === id);
const solution = c.solutions.find(item => item.id === id);
const caseStudy = c.cases.find(item => item.id === id);
const insight = c.insights.find(item => item.id === id);
const whatsapp = `https://wa.me/${site.whatsapp.e164}?text=${encodeURIComponent(site.whatsapp.prefill)}`;
---
<section class="section"><div class="container">
  {kind === 'products' && <><div class="section-heading"><h2>{t('productsEyebrow')}</h2><a class="text-link" href="/compare/">{t('compare')}<span aria-hidden="true">↗</span></a></div><ProductCards content={c} detailed /></>}
  {kind === 'compare' && <Compare content={c} />}
  {kind === 'solutions' && <><div class="section-heading"><h2>{t('solutionsTitle')}</h2></div><div class="card-grid">{c.solutions.map((item, i) => <article class="resource-card"><p class="product-card__number" aria-hidden="true">{String(i + 1).padStart(2, '0')} /</p><h3><a href={item.path}>{item.title}</a></h3><p>{item.description}</p><a class="text-link" href={item.path}>{t('solutionLink')}<span aria-hidden="true">↗</span></a></article>)}</div></>}
  {kind === 'custom' && <><div class="section-heading"><div class="section-heading__copy"><h2>{t('capabilitiesTitle')}</h2><p>{t('capabilitiesDescription')}</p></div></div><Capabilities content={c} /><p class="description">{t('customScope')}</p><div class="actions"><a href="/contact/" class="button">{t('customCta')}<span aria-hidden="true">↗</span></a></div></>}
  {kind === 'case-studies' && <><div class="section-heading"><h2>{t('casesAll')}</h2></div><CaseCards content={c} /><div class="section"><h2>{t('logosTitle')}</h2><p class="description">{t('logosNote')}</p></div><div class="logo-grid">{site.clientLogos.length ? site.clientLogos.map(asset => <Asset content={c} asset={asset} />) : c.cases.map(() => <div class="placeholder logo-placeholder">{t('logoPlaceholder')}</div>)}</div></>}
  {kind === 'insights' && <><div class="section-heading"><h2>{t('insightsAll')}</h2></div><InsightCards content={c} /><p class="description small-note">{t('whitepaper')}</p></>}
  {kind === 'about' && <div class="stack stack--wide"><div class="detail-layout"><div class="stack"><h2>{t('supplyTitle')}</h2><p>{t('supplyDescription')}</p><ul class="list">{site.teamCapabilities.map(item => <li>{item}</li>)}</ul><p class="small-note">{t('registration')}: {site.registrationNumber}</p></div>{site.manufacturingPhoto ? <Asset content={c} asset={site.manufacturingPhoto} /> : <div class="placeholder">{t('factoryPhoto')}</div>}</div><div class="detail-layout"><div class="stack"><h2>{t('teamTitle')}</h2><p class="metric__value" data-example="true">{t('teamSize')}</p><p class="small-note">{t('teamNote')}</p></div>{site.teamPhoto ? <Asset content={c} asset={site.teamPhoto} /> : <div class="placeholder">{t('teamPhoto')}</div>}</div><div><h2>{t('milestonesTitle')}</h2><ol class="milestones">{site.milestones.map(item => <li><p class="milestones__year">{item.year}</p><p>{item.title}</p></li>)}</ol><p class="small-note">{t('milestonesNote')}</p></div></div>}
  {kind === 'contact' && <div class="contact-layout"><div class="stack"><h2>{t('contactDetails')}</h2><p>{t('responseTime')}</p><p class="small-note">{t('responseNote')}</p><dl class="contact-details"><div class="contact-detail"><dt>{t('whatsapp')}</dt><dd><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">{site.phone}<span aria-hidden="true">↗</span></a><p class="small-note">{t('whatsappNote')}</p></dd></div><div class="contact-detail"><dt>{t('email')}</dt><dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd></div><div class="contact-detail"><dt>{t('phone')}</dt><dd><a class="text-link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></dd></div><div class="contact-detail"><dt>{t('address')}</dt><dd>{site.address}</dd></div></dl><div class="placeholder">{t('map')}</div></div><ContactForm content={c} /></div>}
  {kind === 'faq' && <div class="faq-list">{site.faq.map(item => <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>}
  {kind === 'compliance' && <div class="stack"><h2>{t('certStatus')}</h2><p>{t('certNote')}</p><div class="table-scroll" tabindex="0" role="region" aria-label={t('compliance')}><table><caption>{t('compliance')}</caption><thead><tr><th scope="col">{t('certStandard')}</th><th scope="col">{t('certMarket')}</th><th scope="col">{t('certStatus')}</th><th scope="col">{t('certHolder')}</th></tr></thead><tbody>{c.certifications.map(item => <tr><th scope="row">{item.name}</th><td>{item.market}</td><td class:list={{ 'certification-badge': item.status === 'obtained' }}>{t(item.status)}</td><td>{item.holder}</td></tr>)}</tbody></table></div></div>}
  {(kind === 'privacy' || kind === 'terms') && <article class="article"><p class="notice">{t('legalNote')}</p>{site.legal[kind].map(item => <section><h2>{item.title}</h2><p>{item.body}</p></section>)}</article>}
  {kind === 'product' && product && <div class="detail-layout"><div class="stack stack--wide"><section class="stack"><h2>{t('features')}</h2><ul class="list">{product.capabilities.map(item => <li>{item}</li>)}</ul></section><section class="stack"><h2>{t('useCases')}</h2><ul class="list">{product.useCases.map(item => <li>{item}</li>)}</ul></section><section class="stack"><h2>{t('customOptions')}</h2><ul class="list">{product.customisationOptions.map(item => <li>{item}</li>)}</ul><p>{t('moq')}</p><a class="text-link" href="/contact/">{t('customCta')}<span aria-hidden="true">↗</span></a></section><section class="stack"><h2>{t('compliance')}</h2><CertificationList content={c} ids={product.certifications} /><a class="text-link" href="/compliance/">{t('compliance')}<span aria-hidden="true">↗</span></a></section></div><aside class="stack"><figure class="product-card"><div class="product-card__art"><Concept kind={product.id} label={`${product.name} — ${t('illustration')}`} /></div><figcaption class="product-card__body small-note">{t('illustration')}</figcaption></figure>{product.datasheets.length ? product.datasheets.map(file => <a class="button button--secondary" href={file.href} download>{file.label}</a>) : <p class="small-note">{t('datasheet')}</p>}{product.media.length ? product.media.map(asset => <Asset content={c} asset={asset} />) : <div class="placeholder">{t('video')}</div>}</aside></div>}
  {kind === 'solution' && solution && <div class="stack stack--wide"><section class="stack"><h2>{t('solutionFocus')}</h2><ul class="list">{solution.considerations.map(item => <li>{item}</li>)}</ul></section><section><h2>{t('architectureTitle')}</h2><ol class="architecture">{site.architecture.map(item => <li>{item}</li>)}</ol><p class="small-note">{t('architectureNote')}</p></section><section class="stack"><h2>{t('compareLine')}</h2><a class="text-link" href={c.products.find(p => p.id === solution.product)!.path}>{c.products.find(p => p.id === solution.product)!.name}<span aria-hidden="true">↗</span></a></section></div>}
  {kind === 'case' && caseStudy && <div class="detail-layout"><article class="stack stack--wide">{[ ['clientProfile', caseStudy.clientProfile], ['challenge', caseStudy.challenge], ['solution', caseStudy.solution], ['deployment', caseStudy.deploymentScope] ].map(([key, value]) => <section class="stack"><h2>{t(key)}</h2><p>{value}</p></section>)}<section class="stack"><h2>{t('caseCertificates')}</h2>{caseStudy.certificationsProvided.length ? <CertificationList content={c} ids={caseStudy.certificationsProvided} /> : <p>{t('caseCertificateNote')}</p>}</section>{caseStudy.quote && !caseStudy.isExample && <blockquote><p>{caseStudy.quote.text}</p><cite>{caseStudy.quote.author}</cite></blockquote>}</article><aside class="panel stack"><h2>{t('results')}</h2>{caseStudy.results.map(result => <p class="metric__value">{result}</p>)}{caseStudy.isExample && <p class="small-note">{t('sampleNote')}</p>}</aside></div>}
  {kind === 'insight' && insight && <article class="article"><p class="notice">{t('articleNote')}</p><section><h2>{t('articleOutline')}</h2><ul class="list">{insight.outline.map(item => <li>{item}</li>)}</ul></section><a class="text-link back-link" href="/insights/">{t('backInsights')}<span aria-hidden="true">↗</span></a></article>}
</div></section>
