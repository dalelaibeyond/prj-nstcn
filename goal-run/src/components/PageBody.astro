---
import type { Content } from '../lib/content';
import DirectionCards from './DirectionCards.astro';
import CopyBlocks from './CopyBlocks.astro';
import ContactForm from './ContactForm.astro';
import Compare from './Compare.astro';
import Concept from './Concept.astro';
interface Props { content: Content; kind: string; id?: string }
const { content: c, kind, id } = Astro.props;
const copy = c.pages.find(p => p.path === Astro.url.pathname)!;
const insight = kind === 'insight' ? c.insights.find(p => p.id === id) : undefined;
const blocks = insight?.body ?? copy.blocks;
const productBlocks = kind === 'products' ? blocks.slice(blocks.findIndex(b => b.text === 'AI workflow development')) : blocks;
const displayed = productBlocks.filter(b => !(kind === 'contact' && (b.type === 'table' || b.text === 'All fields are required.' || b.text === 'Contact form')) && !(kind === 'compare' && b.type === 'table'));
---
<section class="section"><div class="container">
  {kind === 'products' && <><h2>Choose your starting point</h2><DirectionCards content={c} blocks={blocks} /></>}
  {['privacy', 'terms'].includes(kind) && <p class="notice">{c.t('legalNote')}</p>}
  {kind === 'product' && <figure class="hero__art"><Concept kind={id} label={`Concept illustration for ${c.products.find(p => p.id === id)!.name}`} /><figcaption>{c.t('illustration')} · Product format and functions to be confirmed.</figcaption></figure>}
  {kind === 'product' && <div class="placeholder"><p>{c.t('video')}</p><p>{c.t('datasheet')}</p></div>}
  {kind === 'contact' ? <div class="contact-layout"><article class="article"><CopyBlocks blocks={displayed} /></article><ContactForm content={c} /></div> : kind === 'faq' ? <><div class="faq-list">{c.site.faq.map(item => <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div><div class="actions"><a class="button" href="/contact/">{c.t('contact')}</a></div></> : <article class="article">{kind === 'compare' && <Compare content={c} />}<CopyBlocks blocks={displayed} /></article>}
</div></section>
