---
import Concept from './Concept.astro';
import type { Content } from '../lib/content';
interface Props { content: Content; detailed?: boolean }
const { content: c, detailed = false } = Astro.props;
---
<div class="card-grid">
  {c.products.map((p, i) => <article class="product-card">
    <figure class="product-card__art"><Concept kind={p.id} label={`${p.name} — ${c.t('illustration')}`} /><figcaption class="small-note">{c.t('illustration')}</figcaption></figure>
    <div class="product-card__body"><div class="product-card__number" aria-hidden="true">{String(i + 1).padStart(2, '0')} /</div><h3><a href={p.path}>{p.name}</a></h3><p>{p.overview}</p>
      {detailed && <><ul class="product-card__specs">{p.capabilities.map(item => <li>{item}</li>)}</ul><p>{c.t('moq')}</p><ul class="product-card__specs">{p.certifications.map(id => { const cert = c.certifications.find(item => item.id === id)!; return <li class:list={{ 'certification-badge': cert.status === 'obtained' }}>{cert.name}: {c.t(cert.status)} · {cert.holder}</li>; })}</ul>{p.datasheets.length ? p.datasheets.map(file => <a class="text-link" href={file.href} download>{file.label}</a>) : <p>{c.t('datasheet')}</p>}{!p.media.length && <p>{c.t('video')}</p>}</>}
      <a class="text-link" href={p.path}>{c.t('productLink')}<span aria-hidden="true">↗</span></a>
    </div>
  </article>)}
</div>
