      <rect x="105" y="74" width="150" height="77" rx="6" class="concept__accent" />
      <path d="M153 172v24h54v-24M120 201h120M130 110v15M146 100v35M162 106v23M178 90v52M194 103v28M210 98v37M226 112v12" />
    </> : kind === 'ai-glasses' ? <>
