      <circle cx="180" cy="113" r="64" />
      <path d="M77 44l57 37M280 45l-55 37M175 173v33" />
      <rect x="139" y="72" width="82" height="82" rx="22" class="concept__fill" />
      <path d="M161 99h38v29h-38zM151 93h-12M151 106h-12M151 119h-12M151 132h-12M209 93h12M209 106h12M209 119h12M209 132h12" />
      <rect x="35" y="19" width="58" height="48" rx="13" class="concept__fill" />
