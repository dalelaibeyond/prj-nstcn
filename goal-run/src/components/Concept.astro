    {kind === 'ai-toys' ? <>
      <circle cx="130" cy="55" r="24" class="concept__accent" />
      <circle cx="230" cy="55" r="24" class="concept__accent" />
      <rect x="111" y="55" width="138" height="128" rx="54" class="concept__fill" />
      <circle cx="156" cy="112" r="6" /><circle cx="204" cy="112" r="6" />
      <path d="M162 136q18 17 36 0M125 183v15M235 183v15" />
      <path d="M85 90v50M75 104v22M275 90v50M285 104v22" />
